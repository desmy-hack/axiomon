# Réseau : RPC local (npm run chain) ou fournisseur Sepolia (Alchemy, Infura, ...)
RPC_URL=http://127.0.0.1:8545
EXPLORER_URL=https://sepolia.etherscan.io

# Compte propriétaire (clé NEUVE, jamais une vraie clé). En local : une clé affichée par `npm run chain`
OWNER_PRIVATE_KEY=

# Secrets : 2 valeurs différentes, 32 octets hexadécimaux
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
MASTER_KEY=

# Adresse du contrat (écrite dans build/deployment.json par `npm run deploy`)
CONTRACT_ADDRESS=
INITIAL_SUPPLY=1000000

# Application
PORT=3000
ADMIN_USERNAME=admin
FAUCET_AMOUNT=100
GAS_TOPUP_ETH=0.002
GAS_MIN_ETH=0.0005
# Limite d'AXN envoyés par adresse sur 24 h (modifiable ensuite dans l'administration)
DAILY_LIMIT=20000
# Verrouillage de connexion
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Disque persistant en production (facultatif)
# DB_PATH=/data/axiomon.db
